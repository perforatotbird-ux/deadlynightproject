extends SceneTree
const Body=preload("res://scripts/survival/BodyModel.gd")
const Items=preload("res://scripts/survival/SurvivalItems.gd")
var passes:=0
var failures:=0
func check(ok:bool,text:String)->void:
 if ok:passes+=1;print("PASS: "+text)
 else:failures+=1;print("FAIL: "+text)
func _initialize()->void:
 var b:=Body.new()
 check(b.calories==2125 and b.food==85,"playable starting calorie reserve")
 check(b.burn_rate(true,false)==75,"sleep burns 75 kcal per game hour")
 check(b.burn_rate(false,false)==100,"idle burns 100 kcal per game hour")
 check(b.burn_rate(false,false,true)==180,"walking burns 180 kcal per game hour")
 check(b.burn_rate(false,true)==350,"sprinting burns 350 kcal per game hour")
 check(b.burn_rate(false,false,false,true)==250,"heavy work burns 250 kcal per game hour")
 check(b.burn_rate(false,true,true,false,1,35)==437.5,"full backpack adds 25 percent moving effort")
 check(b.burn_rate(false,false,false,false,0,0)==125,"severe cold adds 25 percent")
 check(b.burn_rate(true,false,false,false,2,80)==75,"backpack does not penalize sleeping")
 check(b.burn_rate(false,true,true,false,999,80)==525,"overload multiplier is bounded")
 b.tick(60,false,80,100,false,true)
 check(is_equal_approx(b.calories,1945) and b.calories_burned==180,"game-hour walking consumes exact kcal")
 b.food=40;check(b.calories==1000,"legacy dev percentage writes convert to calories")
 check(b.add_calories(1125)==1125 and b.calories==2125,"ration adds actual energy")
 check(b.add_calories(1125)==375 and b.calories==2500,"capacity caps excess energy")
 check(b.add_calories(-1)==0 and b.add_calories(INF)==0,"invalid intake cannot damage or overflow reserves")
 b.import_state({"food":20});check(b.calories==500,"legacy save migration preserves proportion")
 b.import_state({"food":20,"calories":1234.5,"calories_burned":870});check(b.calories==1234.5 and b.calories_burned==870,"new calories override legacy projection")
 var saved:Dictionary=JSON.parse_string(JSON.stringify(b.export_state()));b.import_state(saved)
 check(b.calories==1234.5 and b.calories_burned==870,"fractional calorie values survive JSON roundtrip")
 b.import_state({"calories":INF});check(b.calories==0,"nonfinite saved calories are sanitized")
 b.import_state({"calories":99999});check(b.calories==2500,"oversized saved reserve is bounded")
 b.import_state({});b.freeze_needs=true;var before:=b.calories;b.tick(60,false,0,0,true)
 check(b.calories==before and b.calories_burned==0,"freeze needs stops metabolism")
 b.import_state({"calories":50,"water":100});var damage:=b.tick(60,false,80,100,false)
 check(is_equal_approx(damage,-0.75),"starvation damages only unfed half of hour")
 check(b.calories==0 and b.causes.has("starvation"),"empty reserve has explicit starvation cause")
 b.add_calories(300);check(b.tick(1,false,80,100,false)==0 and not b.causes.has("starvation"),"food stops further starvation without healing")
 b.import_state({"calories":0,"water":100});b.tuning.food_awake=0
 check(is_equal_approx(b.tick(60,false,80,100,false),-1.5),"zero burn tuning does not protect already-starving body")
 var one:=Body.new();var many:=Body.new();one.tick(60,false,80,100,false,true)
 for i in 60:many.tick(1,false,80,100,false,true)
 check(is_equal_approx(one.calories,many.calories),"burn independent of integration step")
 b.import_state({});b.tick(480,true,80,100,false);check(b.calories==1525,"eight hours sleep cost 600 kcal")
 for id in ["ration","berries","krasnitsa","sizovka","bolotnitsa","forest_fat","cooked_forest_fat","cooked_wood_fan","wood_tea"]:
  check(Items.calories_for(id)>0 and Items.item(id).calories==Items.calories_for(id),"canonical energy in item metadata: "+id)
 check(Items.calories_for("ration")==1125 and Items.calories_for("berries")==300,"legacy ration and berry portions retain energy value")
 check(Items.calories_for("forest_fat")==125 and Items.calories_for("cooked_forest_fat")==225,"cooking changes edible mushroom energy")
 check(Items.calories_for("water")==0 and Items.calories_for("antitoxin")==0 and Items.calories_for("cooked_pale_bell")==0,"water medicine and poisonous mushrooms do not become food")
 print("CALORIE SUMMARY: %d PASS, %d FAIL" % [passes,failures]);quit(1 if failures else 0)
