; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is easy to edit here with an editor if needed.

config_version=5

[application]

config/name="Deadly Night"
config/description="Deadly Night - Spring Forest 4x4 km Level Design MVP"
config/version="1.1"
run/main_scene="res://scenes/viewer/MapViewer.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=false
