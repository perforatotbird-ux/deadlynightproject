; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is easy to edit here with an editor if needed.

config_version=5

[application]

config/name="Deadly Night"
config/description="Deadly Night - Atmospheric First Person Survival"
config/version="0.4.7"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=false
